# Supabase (Fase 0 — carga do corpus / Fase 5 — auth/SaaS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # service_role: necessário para ingestão (bypassa RLS). NUNCA usar no frontend.
SUPABASE_ANON_KEY=           # anon: usada pelo leitor server-only (Fase 1). Respeita RLS; corpus tem leitura pública. Em Supabase → Project Settings → API.

# Connection string do Postgres — usada SÓ para aplicar migrations (DDL) via
# `supabase db push --db-url "$SUPABASE_DB_URL"`. PostgREST/service-role não roda DDL.
# Onde obter: Supabase → Project Settings → Database → Connection string → "Session pooler"
# (URI). Copie a URI e troque [YOUR-PASSWORD] pela senha do banco.
# IMPORTANTE: use a Session pooler (porta 5432, IPv4) e ENVOLVA EM ASPAS SIMPLES
# (a query string pode ter & que quebra o parsing do .env sem aspas).
# Ex.: SUPABASE_DB_URL='postgresql://postgres.bahcaceazegrynmajsdz:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres'
SUPABASE_DB_URL=

# Auth (Fase 5) — clientes @supabase/ssr (server + browser). A anon key é pública por design.
NEXT_PUBLIC_SUPABASE_URL=        # = SUPABASE_URL (exposto ao browser para o cliente de auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # = SUPABASE_ANON_KEY (anon, respeita RLS — seguro no browser)

# Tradução das glosas EN -> PT (passo translate da ingestão)
# Provider configurável: gemini | anthropic
# gemini tem camada gratuita (https://aistudio.google.com/apikey), sem cartão.
TRANSLATE_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Modelo padrão se TRANSLATE_PROVIDER=gemini (deixe vazio para usar o default gemini-2.5-flash)
# Obs: gemini-2.0-flash pode vir com free tier zerado (limit:0) em projetos com billing vinculado.
# TRANSLATE_MODEL=gemini-2.5-flash

# --- Anthropic (Claude) — alternativa paga ---
ANTHROPIC_API_KEY=
# Modelo padrão se TRANSLATE_PROVIDER=anthropic:
# TRANSLATE_MODEL=claude-haiku-4-5-20251001

# --- IA do estudo (chat / estudo com IA) ---
# Cadeia de failover (a 1ª que conectar é usada). Ordem em runtime:
#   1. chave Gemini DO USUÁRIO (BYOK, cadastrada em /settings) — gasta a cota dele
#   2. chaves Gemini compartilhadas abaixo (GEMINI_API_KEY[_2..N]) — rede de segurança 1
#   3. Groq (provedor distinto, free tier generoso) — rede de segurança 2
# Modelos (opcional; deixe vazio para usar os defaults):
# GEMINI_GEN_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_GEN_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Groq — crie a chave grátis em https://console.groq.com/keys (sem cartão).
GROQ_API_KEY=

# Segredo para CIFRAR a chave BYOK de cada usuário (AES-256-GCM, lib/crypto.ts).
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Sem ela o cadastro de chave BYOK fica indisponível (o app ainda usa as chaves
# compartilhadas / Groq). NUNCA versione o valor real.
APP_SECRET_KEY=

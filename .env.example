# Supabase (Fase 0 — carga do corpus / Fase 5 — auth/SaaS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # service_role: necessário para ingestão (bypassa RLS). NUNCA usar no frontend.
SUPABASE_ANON_KEY=           # anon: usada pelo leitor server-only (Fase 1). Respeita RLS; corpus tem leitura pública. Em Supabase → Project Settings → API.

# Auth (Fase 5) — clientes @supabase/ssr (server + browser). A anon key é pública por design.
NEXT_PUBLIC_SUPABASE_URL=        # = SUPABASE_URL (exposto ao browser para o cliente de auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # = SUPABASE_ANON_KEY (anon, respeita RLS — seguro no browser)

# Tradução das glosas EN -> PT (passo translate da ingestão)
# Provider configurável: gemini | anthropic
# gemini tem camada gratuita (https://aistudio.google.com/apikey), sem cartão.
TRANSLATE_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Modelo padrão se TRANSLATE_PROVIDER=gemini (deixe vazio para usar o default gemini-2.5-flash)
# Obs: gemini-2.0-flash pode vir com free tier zerado (limit:0) em projetos com billing vinculado.
# TRANSLATE_MODEL=gemini-2.5-flash

# --- Anthropic (Claude) — alternativa paga ---
ANTHROPIC_API_KEY=
# Modelo padrão se TRANSLATE_PROVIDER=anthropic:
# TRANSLATE_MODEL=claude-haiku-4-5-20251001
